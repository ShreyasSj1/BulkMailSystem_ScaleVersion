PORT=5000
EMAIL=your_email@gmail.com
PASSWORD=your_google_app_password
MONGO_URI=mongodb://127.0.0.1:27017/email_system
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SENDER_NAME=NIEdge
REPLY_TO=support@niedge.com
APP_BASE_URL=http://localhost:5000

# SAFE_MODE=true keeps sending in a conservative Gmail-friendly profile.
# Set to false only if you intentionally want to tune for a non-Gmail SMTP provider.
SAFE_MODE=true

# Max sends allowed per second. SAFE_MODE clamps this to 1 for Gmail safety.
EMAILS_PER_SECOND=1

# Number of jobs worker can actively process at once. SAFE_MODE clamps this to 1.
MAX_CONCURRENCY=1

# Legacy queue staging group size. Safe to keep low.
BATCH_SIZE=10

# If enabled, recipients are scheduled in chunks instead of one continuous wave.
ENABLE_RECIPIENT_CHUNKING=true

# Example Gmail-safe chunk: 25 recipients every few minutes.
RECIPIENT_CHUNK_SIZE=25
CHUNK_INTERVAL_MIN_MS=120000
CHUNK_INTERVAL_MAX_MS=240000

# Pause briefly after each chunk to keep queue draining gradual under load.
DRAIN_COOLDOWN_MIN_MS=15000
DRAIN_COOLDOWN_MAX_MS=45000
